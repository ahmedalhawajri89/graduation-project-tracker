# ─────────────────────────────────────────────────────────────
#  تخرُّج — قالب البيئة (للتطوير المحلي)
#  في الإنتاج: غيّر كل سطر عليه «الإنتاج:» — التفصيل في README › النشر
# ─────────────────────────────────────────────────────────────

APP_NAME="Takharruj"
APP_ENV=local                # الإنتاج: production
APP_KEY=                     # php artisan key:generate
APP_DEBUG=true               # الإنتاج: false — وإلا تكشف صفحة الخطأ تتبّع الكود
APP_URL=http://localhost     # الإنتاج: https://your-domain — روابط استرجاع كلمة السر تُبنى منه
APP_TIMEZONE=Asia/Gaza       # توقيت المستخدمين: «اليوم» ومواعيد المراحل تُحسب به

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug              # الإنتاج: warning

DB_CONNECTION=mysql          # MySQL 8+ أو MariaDB 10.2+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=graduation_clc   # الاختبارات تعمل على نسخة باسم <هذا>_testing — php artisan test:prepare
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local

# البريد في الطابور: مع database يلزم عامل — المجدوِل يشغّله كل دقيقة
# (cron: * * * * * php artisan schedule:run). محلياً sync يرسل فوراً بلا عامل.
QUEUE_CONNECTION=database

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false  # الإنتاج (HTTPS): true

MAIL_MAILER=smtp             # محلياً: log يكتب الرسائل في storage/logs بلا خادم بريد
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"   # الإنتاج: عنوان حقيقي — بدونه تفشل رسائل الاسترجاع
MAIL_FROM_NAME="${APP_NAME}"

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
